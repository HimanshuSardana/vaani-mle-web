# Any OpenAI-compatible provider for POST /v1/chat/completions.
# Only OPENAI_MODEL is read today; the rest are wired up when the mock reply
# is replaced, so the app runs without any of them.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Model id used when a request omits `model`. Defaults to astra-max.
OPENAI_MODEL=astra-max

# web_search runs on Tavily, falling back to the SearXNG instance below when
# Tavily is missing, errors, or finds nothing.
TAVILY_API_KEY=

# Fallback: the key is sent as X-API-Key; localhost/private callers may not need one.
SEARXNG_URL=https://search.himanshu.co
SEARXNG_API_KEY=

# Auth (better-auth). Without Google credentials the sign-in button is inert;
# everything else still runs as a guest.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SQLite file used for auth, chats and memories (defaults to ./data/recall.db).
DATABASE_PATH=

# RAG over lib/rag/corpus.jsonl (the three papers), served at /api/rag/*.
# OPENCODE_API_KEY carries the opencode go key; every request also needs
# x-opencode-session, which the client sends from OPENCODE_SESSION.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
OPENCODE_SESSION=vaani-rag
RAG_MODEL=deepseek-v4.1-flash

# Tools the chat route advertises. Both are off unless explicitly enabled.
# Off: nothing is searched, and conversations are neither stored nor recalled.
ENABLE_WEB_SEARCH=0
ENABLE_MEMORY_RECALL=0

# Sent upstream as reasoning_effort. "none" stops providers that honour it from
# spending tokens thinking, and the relay hides any trace from providers that
# don't. Leave empty to send no reasoning parameter at all.
REASONING_EFFORT=none

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
