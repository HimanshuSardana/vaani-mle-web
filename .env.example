# Any OpenAI-compatible provider for POST /v1/chat/completions.
# Only OPENAI_MODEL is read today; the rest are wired up when the mock reply
# is replaced, so the app runs without any of them.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Model id used when a request omits `model`. Defaults to astra-max.
OPENAI_MODEL=astra-max

# web_search runs on Tavily, falling back to the SearXNG instance below when
# Tavily is missing, errors, or finds nothing.
TAVILY_API_KEY=

# Fallback: the key is sent as X-API-Key; localhost/private callers may not need one.
SEARXNG_URL=https://search.himanshu.co
SEARXNG_API_KEY=

# Auth (better-auth). Without Google credentials the sign-in button is inert;
# everything else still runs as a guest.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SQLite file used for auth, chats and memories (defaults to ./data/recall.db).
DATABASE_PATH=
